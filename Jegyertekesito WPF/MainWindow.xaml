<Window x:Class="Jegyertekesito.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jegyértékesítő"
        Height="450"
        Width="800">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="TicketsGrid"
                  Grid.Row="0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="0,0,0,10">

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="80"/>

                <DataGridTextColumn Header="Jegynév"
                                    Binding="{Binding Nev}"
                                    Width="*"/>

                <DataGridTextColumn Header="Ár"
                                    Binding="{Binding Ar, StringFormat={}{0:N0} Ft}"
                                    Width="150"/>

                <DataGridTextColumn Header="Darabszám"
                                    Binding="{Binding Darabszam}"
                                    Width="120"/>

            </DataGrid.Columns>

        </DataGrid>

        <!-- MainWindow.xaml – csak a StackPanel rész változik -->
        <StackPanel Grid.Row="1"
    Orientation="Horizontal"
    HorizontalAlignment="Center">

            <Button x:Name="AddButton"
    Content="Hozzáadás"
    Width="120"
    Height="35"
    Margin="5"
    Click="AddButton_Click"/>

            <Button x:Name="EditButton"
    Content="Szerkesztés"
    Width="120"
    Height="35"
    Margin="5"
    Click="EditButton_Click"/>
            <!-- EZ HIÁNYZOTT -->

            <Button x:Name="DeleteButton"
    Content="Törlés"
    Width="120"
    Height="35"
    Margin="5"
    Click="DeleteButton_Click"/>
            <!-- EZ HIÁNYZOTT -->

        </StackPanel>

    </Grid>

</Window>